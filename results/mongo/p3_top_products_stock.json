{
 "pipeline": [
  {
   "$unwind": "$items"
  },
  {
   "$group": {
    "_id": "$items.product_id",
    "units": {
     "$sum": "$items.quantity"
    },
    "revenue": {
     "$sum": "$items.subtotal"
    },
    "orders": {
     "$sum": 1
    }
   }
  },
  {
   "$sort": {
    "units": -1
   }
  },
  {
   "$limit": 15
  },
  {
   "$lookup": {
    "from": "products",
    "localField": "_id",
    "foreignField": "_id",
    "as": "p"
   }
  },
  {
   "$set": {
    "name": {
     "$first": "$p.name"
    },
    "category": {
     "$first": "$p.category.name"
    },
    "current_stock": {
     "$first": "$p.current_stock"
    },
    "is_active": {
     "$first": "$p.is_active"
    },
    "revenue": {
     "$round": [
      "$revenue",
      2
     ]
    }
   }
  },
  {
   "$project": {
    "p": 0
   }
  }
 ],
