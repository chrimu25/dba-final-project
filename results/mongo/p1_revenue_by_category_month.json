{
 "pipeline": [
  {
   "$project": {
    "month": {
     "$dateToString": {
      "format": "%Y-%m",
      "date": "$timestamp"
     }
    },
    "ratio": {
     "$cond": [
      {
       "$gt": [
        "$subtotal",
        0
       ]
      },
      {
       "$divide": [
        "$total",
        "$subtotal"
       ]
      },
      0
     ]
    },
    "items": 1
   }
  },
  {
   "$unwind": "$items"
  },
  {
   "$group": {
    "_id": {
     "category": "$items.category_id",
     "month": "$month"
    },
    "gross": {
     "$sum": "$items.subtotal"
    },
    "net": {
     "$sum": {
      "$multiply": [
       "$items.subtotal",
       "$ratio"
      ]
     }
    },
    "units": {
     "$sum": "$items.quantity"
    },
    "lines": {
     "$sum": 1
    }
   }
  },
  {
   "$facet": {
    "by_category": [
     {
      "$group": {
       "_id": "$_id.category",
       "net": {
        "$sum": "$net"
       },
       "gross": {
        "$sum": "$gross"
       },
       "units": {
        "$sum": "$units"
       }
      }
     },
     {
      "$lookup": {
       "from": "categories",
       "localField": "_id",
       "foreignField": "_id",
       "as": "c"
      }
     },
     {
      "$set": {
       "name": {
        "$first": "$c.name"
       },
       "net": {
        "$round": [
         "$net",
         2
        ]
       },
       "gross": {
        "$round": [
         "$gross",
         2
        ]
       }
      }
     },
     {
      "$project": {
       "c": 0
      }
     },
     {
      "$sort": {
       "net": -1
      }
     }
    ],
    "by_month": [
     {
      "$group": {
       "_id": "$_id.month",
       "net": {
        "$sum": "$net"
       },
       "units": {
        "$sum": "$units"
       }
      }
     },
     {
      "$set": {
       "net": {
        "$round": [
         "$net",
         2
        ]
       }
      }
     },
     {
      "$sort": {
       "_id": 1
      }
     }
    ],
    "category_month": [
     {
      "$set": {
       "net": {
        "$round": [
         "$net",
         2
        ]
       }
      }
     },
     {
      "$sort": {
       "_id.category": 1,
       "_id.month": 1
      }
     }
    ]
   }
  }
 ],
